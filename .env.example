# Copy to .env locally; NEVER commit actual credentials.
# This project does not automatically load .env: source it in the server shell.
# No API credentials are required for synthetic data or existing NASA CSVs.
# DeepSeek defaults checked against official documentation on 2026-11-14.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-flash
# Separate Tavily search key: DeepSeek tokens do not authenticate Tavily.
POLICY_SEARCH_API_KEY=
